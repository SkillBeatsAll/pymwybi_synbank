# Syn Bank Client Opportunity Copilot — environment template
#
# Copy this file to `.env` and fill in your key:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file is the committed
# template and must never contain a real key.
#
# Everything here is OPTIONAL. With no key at all the copilot still runs: it
# serves stored demo answers where it has them and deterministic answers
# otherwise, labelled "Demo / AI unavailable". Every figure is real either way —
# the language model only writes the prose, it never produces a number.
#
# A value already set in your shell wins over the value in this file, so
# `DEEPSEEK_API_KEY=... python -m src.syn_wallet.ask "..."` overrides it for one
# command without editing anything.


# ---------------------------------------------------------------------------
# Provider key — set ONE of these
# ---------------------------------------------------------------------------

# DeepSeek (the configured primary). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# NVIDIA NIM (alternative). Get a key at https://build.nvidia.com
# NVIDIA_API_KEY=


# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Which provider to use. Leave unset to auto-select the first one whose key is
# present, in the order: deepseek, nvidia.
#   deepseek | nvidia
# SYN_COPILOT_PROVIDER=deepseek

# Which model to ask. Leave unset for the provider's default:
#   deepseek -> deepseek-chat
#   nvidia   -> z-ai/glm-5.2
#
# DeepSeek model names, for reference:
#   deepseek-chat       the default. This stage only writes prose — the
#                       reasoning was already done by the deterministic layers —
#                       so a non-reasoning model is the right tool.
#   deepseek-v4-flash   a REASONING model, despite the name. Fully supported,
#                       but measured on the same client briefing it spends 16k
#                       characters thinking before writing: 38.5s and 5,545
#                       tokens, against 10.9s and 1,717 for deepseek-chat, for
#                       an answer of the same quality.
#   deepseek-v4-pro     slower again, and unnecessary here.
#
# Model names move faster than documentation. Confirm what your own key can
# actually reach with:
#   python -m src.syn_wallet.ask --list-models
# SYN_COPILOT_MODEL=deepseek-v4-flash

# Override the endpoint. Only needed for a proxy or a self-hosted deployment.
# SYN_COPILOT_BASE_URL=https://api.deepseek.com
